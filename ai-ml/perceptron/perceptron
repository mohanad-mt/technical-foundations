import numpy as np

X = np.array([
    [1, 2],
    [2, 3],
    [3, 4],
    [4, 5]
])

labels = np.array([1, 1, -1, -1])

training_data = list(zip(X, labels))

w = np.zeros(X.shape[1])
b = 0

while True:
    mistakes = 0

    for x, y in training_data:

        prediction = np.dot(w, x) + b

        score = y * prediction

        if score <= 0:
            mistakes += 1

            w += y * x
            b += y

    if mistakes == 0:
        break

print("w:", w)
print("b:", b)