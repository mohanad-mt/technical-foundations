/**
 * 16-bit incrementer:
 * out = in + 1
 */
CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    Xor(a=in[0] , b=true , out= out[0]);
    Xor(a=in[1] , b= in[0], out=out[1] );
    And(a=in[1],b=in[0],out=w1);
    Xor(a=in[2] , b=w1 , out=out[2]);
    And(a=in[2],b=w1,out=w2);
    Xor(a=in[3] , b=w2 , out=out[3]);
    And(a=in[3],b=w2,out=w3);
    Xor(a=in[4] , b=w3 , out=out[4]);
    And(a=in[4],b=w3,out=w4);
    Xor(a=in[5] , b=w4 , out=out[5]);
    And(a=in[5],b=w4,out=w5);
    Xor(a=in[6] , b=w5 , out=out[6]);
    And(a=in[6],b=w5,out=w6);
    Xor(a=in[7] , b=w6 , out=out[7]);
    And(a=in[7],b=w6,out=w7);
    Xor(a=in[8] , b=w7 , out=out[8]);
    And(a=in[8],b=w7,out=w8);
    Xor(a=in[9] , b=w8 , out=out[9]);
    And(a=in[9],b=w8,out=w9);
    Xor(a=in[10] , b=w9 , out=out[10]);
    And(a=in[10],b=w9,out=w10);
    Xor(a=in[11] , b=w10 , out=out[11]);
    And(a=in[11],b=w10,out=w11);
    Xor(a=in[12] , b=w11 , out=out[12]);
    And(a=in[12],b=w11,out=w12);
    Xor(a=in[13] , b=w12 , out=out[13]);
    And(a=in[13],b=w12,out=w13);
    Xor(a=in[14] , b=w13 , out=out[14]);
    And(a=in[14],b=w13,out=w14);
    Xor(a=in[15] , b=w14 , out=out[15]);
        



}